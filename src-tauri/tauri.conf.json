{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SQLighter",
  "version": "0.1.0",
  "identifier": "dev.sqlighter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Modern, minimal and secure SQL client",
    "longDescription": "SQLighter is a modern, minimal and secure SQL client for PostgreSQL, MySQL, MariaDB, SQLite, SQL Server, Oracle and CockroachDB with a built-in AI assistant.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/sqlighter-mcp-bridge.mjs": "sqlighter-mcp-bridge.mjs" }
  }
}
